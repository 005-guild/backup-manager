DB_PASSWORD=replace-with-a-long-random-password
DBAAS_ASSET_URL=http://your-dbaas-host/api/apiService/service/DBLIST
DBAAS_ASSET_TOKEN=replace-with-a-private-token
DBAAS_ASSET_PAGE_SIZE=500
DBAAS_ASSET_MAX_PAGES=1000
DBAAS_ASSET_CRON=0 0 0 * * *
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-private-password-of-at-least-12-characters
APP_PORT=8080
COOKIE_SECURE=false

BACKUP_DAILY_URL=http://your-backup-platform/api/apiService/service/Op_Backup_Meg
BACKUP_DAILY_TOKEN=replace-with-a-new-token
BACKUP_DAILY_DATA_PATH=
BACKUP_DAILY_PAGE_SIZE=20000
BACKUP_DAILY_MAX_PAGES=100

# OceanProtect 月备/年备：填写平台根地址，不要包含 /v1 路径。
OCEANPROTECT_BASE_URL=https://your-oceanprotect-host:25081
OCEANPROTECT_USERNAME=replace-with-oceanprotect-user
OCEANPROTECT_PASSWORD=replace-with-oceanprotect-password
OCEANPROTECT_AUTH_TYPE=STORAGE_SYSTEM
OCEANPROTECT_USER_TYPE=common
OCEANPROTECT_LANGUAGE=1
OCEANPROTECT_PAGE_SIZE=100
OCEANPROTECT_SLA_PAGE_SIZE=100
OCEANPROTECT_MAX_PAGES=1000

BACKUP_SYNC_CRON=0 0 6 * * *
