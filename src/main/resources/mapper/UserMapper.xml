<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backupmanager.UserMapper">
  <resultMap id="userAccount" type="com.example.backupmanager.UserAccount">
    <constructor>
      <arg column="username" javaType="java.lang.String"/>
      <arg column="password_hash" javaType="java.lang.String"/>
      <arg column="role" javaType="java.lang.String"/>
      <arg column="enabled" javaType="_boolean"/>
    </constructor>
  </resultMap>

  <select id="findAccount" resultMap="userAccount">
    select username, password_hash, role, enabled from app_user where username = #{username}
  </select>

  <select id="countAll" resultType="_long">
    select count(*) from app_user
  </select>

  <select id="findAll" resultType="map">
    select id, username, role, enabled, created_at from app_user order by username
  </select>

  <insert id="insert">
    insert into app_user(username, password_hash, role)
    values(#{username}, #{passwordHash}, #{role})
  </insert>
</mapper>
